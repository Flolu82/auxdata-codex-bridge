# Einfacher: einrichten.cmd (Windows) bzw. ./einrichten.sh legt die Datei .env fuer dich an
# und prueft den Schluessel gleich mit.
#
# Von Hand: diese Datei nach .env kopieren (gleicher Ordner) und den Schluessel eintragen.
# .env steht in .gitignore und wird nicht eingecheckt.

# Dein persoenlicher API-Schluessel aus AuxData:
# Avatar-Menue -> Persoenliche Einstellungen -> Karte "API-Schluessel" -> neuen Schluessel erzeugen.
# Er wird nur einmal angezeigt und beginnt mit sk-auxdata-
AUXDATA_API_KEY=

# Nur noetig, wenn deine Organisation eine eigene AuxData-Instanz betreibt:
# AUXDATA_BASE_URL=https://auxdata.ai

# Nur noetig, wenn Port 8790 belegt ist:
# BRIDGE_PORT=8790
